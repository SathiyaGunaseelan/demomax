<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Max Mobiles</title>
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg1:#f3f6fc; --bg2:#e3eaf7; --card:rgba(255,255,255,.72); --border:rgba(74,111,165,.18);
  --ink:#1f2d4d; --muted:#6a7896; --primary:#3f63a8; --primary2:#5b86d1; --accent:#e9b872;
  --btn-text:#fff; --shadow:0 18px 50px rgba(44,68,120,.16);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg1:#0f1729; --bg2:#172340; --card:rgba(30,44,78,.6); --border:rgba(140,170,230,.2);
    --ink:#eef2fb; --muted:#9cabc9; --primary:#5b86d1; --primary2:#7fa4ea; --accent:#e9b872; --shadow:0 18px 50px rgba(0,0,0,.4);
  }
}
:root[data-theme="dark"]{
  --bg1:#0f1729; --bg2:#172340; --card:rgba(30,44,78,.6); --border:rgba(140,170,230,.2);
  --ink:#eef2fb; --muted:#9cabc9; --primary:#5b86d1; --primary2:#7fa4ea; --accent:#e9b872; --shadow:0 18px 50px rgba(0,0,0,.4);
}
*,*::before,*::after{box-sizing:inherit;margin:0}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{
  min-height:100%;font-family:"Poppins","Segoe UI",system-ui,-apple-system,sans-serif;color:var(--ink);
  background:
    radial-gradient(600px 400px at 85% -5%,rgba(91,134,209,.25),transparent 60%),
    radial-gradient(500px 380px at 0% 105%,rgba(233,184,114,.22),transparent 60%),
    linear-gradient(160deg,var(--bg1),var(--bg2));
  background-color:var(--bg1);display:flex;align-items:center;justify-content:center;padding:32px 18px;
}
.card{
  width:100%;max-width:440px;background:var(--card);border:1px solid var(--border);border-radius:32px;
  padding:44px 28px 30px;text-align:center;box-shadow:var(--shadow);
  -webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);
}
.logo{
  width:128px;height:128px;margin:0 auto 22px;border-radius:50%;display:grid;place-items:center;
  background:linear-gradient(145deg,#fff,var(--bg2));border:1px solid var(--border);
  box-shadow:0 0 0 8px rgba(91,134,209,.12),var(--shadow);
}
.logo svg{width:76px;height:76px}
h1{font-size:2rem;letter-spacing:.04em;font-weight:700;color:var(--ink)}
h1 span{color:var(--primary)}
.tag{margin-top:6px;color:var(--muted);font-size:.9rem;letter-spacing:.14em;text-transform:uppercase}
.divider{width:56px;height:3px;border-radius:3px;margin:22px auto 26px;background:linear-gradient(90deg,var(--primary),var(--accent))}
.links{display:flex;flex-direction:column;gap:14px}
.btn{
  display:flex;align-items:center;gap:14px;padding:15px 20px;border-radius:18px;text-decoration:none;
  font-weight:600;font-size:1rem;color:var(--btn-text);
  background:linear-gradient(135deg,var(--primary),var(--primary2));
  box-shadow:0 8px 20px rgba(63,99,168,.28);transition:transform .2s,box-shadow .2s;
}
.btn:hover,.btn:focus-visible{transform:translateY(-3px);box-shadow:0 14px 28px rgba(63,99,168,.36);outline:none}
.btn .ic{width:38px;height:38px;flex:none;border-radius:12px;background:rgba(255,255,255,.2);display:grid;place-items:center}
.btn svg{width:20px;height:20px;fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.btn .txt{flex:1;text-align:left}
.btn .arr{opacity:.8;width:18px;height:18px}
footer{margin-top:28px;font-size:.78rem;color:var(--muted)}
</style>
</head>
<body>
<main class="card">
  <!-- LOGO: placeholder mark. Replace with your real logo later. -->
  <div class="logo" aria-label="Max Mobiles logo">
    <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
      <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#5b86d1"/><stop offset="1" stop-color="#3f63a8"/></linearGradient></defs>
      <rect x="18" y="6" width="44" height="68" rx="10" fill="url(#g)"/>
      <rect x="23" y="14" width="34" height="48" rx="4" fill="#fff" opacity=".18"/>
      <path d="M28 54V28l12 14 12-14v26" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="40" cy="67" r="2.4" fill="#e9b872"/>
    </svg>
  </div>

  <h1>Max <span>Mobiles</span></h1>
  <p class="tag">Buy &bull; Sell &bull; Exchange</p>
  <div class="divider"></div>

  <nav class="links">
    <a class="btn" href="https://lumeco.vercel.app/" target="_blank" rel="noopener">
      <span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6"/></svg></span>
      <span class="txt">Instagram</span>
      <svg class="arr" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
    </a>
    <a class="btn" href="https://lumeco.vercel.app/" target="_blank" rel="noopener">
      <span class="ic"><svg viewBox="0 0 24 24"><path d="M4 11v2a2 2 0 002 2h2l6 4V5L8 9H6a2 2 0 00-2 2z"/><path d="M18 9a4 4 0 010 6"/></svg></span>
      <span class="txt">WhatsApp Channel</span>
      <svg class="arr" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
    </a>
    <a class="btn" href="https://lumeco.vercel.app/" target="_blank" rel="noopener">
      <span class="ic"><svg viewBox="0 0 24 24"><path d="M21 12a8.5 8.5 0 01-12.6 7.4L3 21l1.7-5.2A8.5 8.5 0 1121 12z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-.8.7a3.5 3.5 0 01-1.9-1.9l.7-.8-1-2z"/></svg></span>
      <span class="txt">WhatsApp Chat</span>
      <svg class="arr" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
    </a>
    <a class="btn" href="https://lumeco.vercel.app/" target="_blank" rel="noopener">
      <span class="ic"><svg viewBox="0 0 24 24"><path d="M12 21s7-6.1 7-11.5A7 7 0 005 9.5C5 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
      <span class="txt">Our Location</span>
      <svg class="arr" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg>
    </a>
  </nav>

  <footer>&copy; Max Mobiles. All rights reserved.</footer>
</main>
</body>
</html>
